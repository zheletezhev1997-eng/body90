function drawStatsChart(){
  const canvas=document.getElementById('statsChart');
  if(!canvas) return;
  const W=canvas.offsetWidth*2;const H=200;
  canvas.width=W;canvas.height=H;
  const ctx=canvas.getContext('2d');
  ctx.fillStyle='#141414';ctx.fillRect(0,0,W,H);

  const barW=Math.floor(W/13)-4;
  const maxH=H-40;
  for(let wi=0;wi<13;wi++){
    const week=wi+1;
    const ph=getPhase(week);
    const days=Array.from({length:7},(_,di)=>wi*7+di).filter(d=>d<90);
    const dc=days.filter(d=>state.completed[d]).length;
    const barH=Math.round((dc/days.length)*maxH);
    const x=wi*(barW+4)+2;
    // bg bar
    ctx.fillStyle='#1a1a1a';
    ctx.fillRect(x,20,barW,maxH);
    // filled bar
    ctx.fillStyle=ph.color+'99';
    if(barH>0) ctx.fillRect(x,20+maxH-barH,barW,barH);
    // label
    ctx.fillStyle='#444';ctx.font='16px system-ui';ctx.textAlign='center';
    ctx.fillText(week,x+barW/2,H-4);
    if(dc>0){
      ctx.fillStyle=ph.color;ctx.font='bold 18px system-ui';
      ctx.fillText(dc,x+barW/2,20+maxH-barH-4);
    }
  }
}

