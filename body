// CALENDAR
// ═══════════════════════════════════════════
function renderCalendar(){
  const done=Object.values(state.completed).filter(Boolean).length;
  const pct=Math.round(done/90*100);
  document.getElementById('prog-text').textContent=`${done} / 90 · ${pct}%`;
  document.getElementById('prog-fill').style.width=pct+'%';

  const grid=document.getElementById('cal-grid');
  grid.innerHTML='';
  for(let wi=0;wi<13;wi++){
    const row=document.createElement('div');
    row.className='week-row';
    const ph=getPhase(wi+1);
    for(let di=0;di<7;di++){
      const idx=wi*7+di;
      if(idx>=90){row.appendChild(document.createElement('div'));continue;}
      const d=getDayData(idx);
      const isDone=state.completed[idx];
      const hasNote=state.notes[idx]&&state.notes[idx].trim();
      const cell=document.createElement('div');
      cell.className='day-cell'+(isDone?' done':'')+(d.label==='ВЫХОДНОЙ'?' rest-day':'')+(hasNote?' has-note':'');
      cell.style.setProperty('--pc',ph.color);
      cell.innerHTML=`<span class="dn">${idx+1}</span><span class="di">${isDone?'✓':d.icon}</span>`;
      cell.onclick=()=>openDay(idx);
      row.appendChild(cell);
    }
    grid.appendChild(row);
  }

  const bars=document.getElementById('week-bars-inner');
  bars.innerHTML='';
  for(let wi=0;wi<13;wi++){
    const week=wi+1;
    const ph=getPhase(week);
    const days=Array.from({length:7},(_,di)=>wi*7+di).filter(d=>d<90);
    const dc=days.filter(d=>state.completed[d]).length;
    bars.innerHTML+=`<div class="wb-row">
      <span class="wb-name">Нед. ${week}</span>
      <div class="wb-track"><div class="wb-fill" style="width:${(dc/days.length)*100}%;background:${ph.color}"></div></div>
      <span class="wb-count">${dc}/${days.length}</span>
      <span class="wb-phase" style="color:${ph.color}">${ph.label}</span>
    </div>`;
  }
}

