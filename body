function renderDay(){
  const d=getDayData(currentDay);
  const ph=d.phase||getPhase(Math.floor(currentDay/7)+1);
  const phColor=ph?ph.color:'#4A90D9';
  const done=state.completed[currentDay];

  document.getElementById('dd-phase-lbl').textContent=`День ${currentDay+1} · Неделя ${Math.floor(currentDay/7)+1} · ${ph?ph.label:''}`;
  document.getElementById('dd-phase-lbl').style.color=phColor;
  document.getElementById('dd-ico').textContent=d.icon||'💪';
  document.getElementById('dd-ttl').textContent=d.label||'';
  document.getElementById('dd-sub').textContent=(d.venue||'')+(d.program?' · '+d.program:'');
  document.getElementById('dd-goal').textContent='🎯 '+(d.goal||'');
  document.getElementById('dd-goal').style.display=d.goal?'block':'none';

  const btn=document.getElementById('done-btn');
  btn.textContent=done?'✓ День выполнен':'Отметить как выполненный';
  btn.className='done-btn'+(done?' done':'');

  document.getElementById('nav-prev').disabled=currentDay===0;
  document.getElementById('nav-next').disabled=currentDay===89;

  // note
  document.getElementById('note-textarea').value=state.notes[currentDay]||'';

  let html='';
  if(d.warmup){
    html+=`<div class="dd-block"><div class="dd-block-ttl" style="color:#888">Разминка</div>
    <div class="dd-block-body"><div class="warmup-txt">${d.warmup}</div></div></div>`;
  }
  if(d.blocks){
    d.blocks.forEach((bl,bi)=>{
      if(!bl.exs||!bl.exs.length) return;
      html+=`<div class="dd-block"><div class="dd-block-ttl" style="color:${d.color||phColor}">${bl.t}</div>
      <div class="dd-block-body">`;
      bl.exs.forEach((ex,ei)=>{
        const last=ei===bl.exs.length-1;
        const wkey=`${currentDay}:${bi}:${ei}`;
        const saved=state.myWeights[wkey]||{};
        const isWeightEx = ex.w && ex.w!=='—' && ex.w!='собств. вес' && ex.w!='—';
        const isBW = ex.w==='собств. вес'||ex.s==='max'||ex.s&&ex.s.includes('max');
        const showTracker = ex.n && ex.s && ex.s!=='ежедневно' && !ex.n.toLowerCase().includes('шаги') && !ex.n.toLowerCase().includes('сон') && !ex.n.toLowerCase().includes('вода') && !ex.n.toLowerCase().includes('взвешива');
        // compute next weight suggestion
        let nextHtml='';
        if(showTracker && !isBW){
          const prevKg=parseFloat(saved.kg)||0;
          const allDone=saved.allDone;
          if(!prevKg){
            nextHtml=`<div class="wt-next-box firsttime">💡 Введи рабочий вес первой тренировки</div>`;
          } else if(allDone){
            const step = prevKg>=40 ? 2.5 : prevKg>=20 ? 2 : 1.25;
            nextHtml=`<div class="wt-next-box up">▲ Следующий раз: <b>${(prevKg+step).toFixed(step===1.25?2:1)} кг</b> (+${step} кг) — все подходы выполнены ✓</div>`;
          } else {
            nextHtml=`<div class="wt-next-box hold">→ Следующий раз: <b>${prevKg} кг</b> — держи вес, добери повторения</div>`;
          }
        }
        if(showTracker && isBW && saved.kg){
          const step=2.5;
          if(saved.allDone){
            nextHtml=`<div class="wt-next-box up">▲ Следующий раз попробуй +${step} кг дополнительного веса</div>`;
          }
        }
        html+=`<div class="ex-row" style="${last&&!showTracker?'':'border-bottom:1px solid var(--bg4)'}">
          <div class="ex-left"><div class="ex-name">${ex.n}</div>${ex.note?`<div class="ex-note">${ex.note}</div>`:''}</div>
          <div class="ex-right">
            ${ex.s?`<div class="ex-sets" style="color:${d.color||phColor};background:${(d.color||phColor)}22">${ex.s}</div>`:''}
            ${ex.w&&ex.w!=='—'?`<div class="ex-weight">${ex.w}</div>`:''}
          </div>
        </div>
        ${showTracker?`<div class="wt-row-wrap" id="wtr-${wkey}">
          <div class="wt-row-top">
            ${!isBW?`<div class="wt-inp-wrap"><label>Мой вес</label><input class="wt-inp" type="number" step="0.5" placeholder="${isWeightEx?ex.w.split('–')[0]||'кг':'кг'}" value="${saved.kg||''}" id="wkg-${wkey}" oninput="onWeightInput('${wkey}')"></div>`:''}
            <div class="wt-inp-wrap"><label>Повт.</label><input class="wt-inp reps-inp" type="number" placeholder="—" value="${saved.reps||''}" id="wreps-${wkey}" oninput="onWeightInput('${wkey}')"></div>
            <label class="wt-all-done"><input type="checkbox" id="wall-${wkey}" ${saved.allDone?'checked':''} onchange="onWeightInput('${wkey}')"><span>Все подходы ✓</span></label>
            <button class="wt-save-btn" onclick="saveWeight('${wkey}')">Сохранить</button>
          </div>
          <div id="wnext-${wkey}">${nextHtml}</div>
        </div>`:''}`;
      });
      html+='</div></div>';
    });
  }
  if(d.cooldown){
    html+=`<div class="dd-block"><div class="dd-block-ttl" style="color:#888">Заминка / растяжка</div>
    <div class="dd-block-body"><div class="warmup-txt">${d.cooldown}</div></div></div>`;
  }
  if(d.tip){
    html+=`<div class="dd-tip" style="border-left:3px solid ${phColor}">
      <div class="dd-tip-lbl" style="color:${phColor}">Совет</div>
      <div class="dd-tip-txt">${d.tip}</div>
    </div>`;
  }
  if(state.customDays[currentDay]){
    html=`<div style="margin:0 20px 8px;padding:6px 12px;background:rgba(217,119,6,0.12);border-radius:8px;font-size:11px;color:var(--orange);font-weight:700">✏️ Редактированная версия</div>`+html;
  }
  document.getElementById('dd-content').innerHTML=html;
}

