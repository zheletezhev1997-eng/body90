<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>BODY90 — 90 дней трансформации</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#0d0d0d;--bg2:#111;--bg3:#141414;--bg4:#1a1a1a;
  --border:#1e1e1e;--border2:#252525;
  --text:#f0f0f0;--text2:#aaa;--text3:#666;--text4:#444;
  --blue:#4A90D9;--orange:#D97706;--red:#DC2626;--green:#16A34A;--purple:#7C3AED;
  --phase1:#4A90D9;--phase2:#D97706;--phase3:#DC2626;
}
body{background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,sans-serif;min-height:100vh;overflow-x:hidden}

/* SCREENS */
.screen{display:none;max-width:720px;margin:0 auto;padding-bottom:72px}
.screen.active{display:block}

/* STICKY HEADER */
.sticky-header{position:sticky;top:0;z-index:50;background:var(--bg2);border-bottom:1px solid var(--border)}
.sticky-header h1{font-size:18px;font-weight:900;padding:16px 20px 4px}
.sticky-header h1 span{color:var(--orange)}
.prog-row{display:flex;justify-content:space-between;padding:0 20px 6px;font-size:11px;color:var(--text3)}
.prog-bar{height:4px;background:var(--bg4);margin:0 20px 12px;border-radius:99px;overflow:hidden}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--phase1),var(--phase2),var(--phase3));border-radius:99px;transition:width .4s}

/* BOTTOM NAV */
.bnav{position:fixed;bottom:0;left:0;right:0;background:var(--bg2);border-top:1px solid var(--border);display:flex;z-index:100;max-width:720px;margin:0 auto}
.bnav-btn{flex:1;padding:10px 4px 8px;background:none;border:none;color:var(--text4);font-size:9px;font-weight:700;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;transition:color .15s;text-transform:uppercase;letter-spacing:.04em}
.bnav-btn .bni{font-size:20px;line-height:1}
.bnav-btn.active{color:var(--orange)}

/* LEGEND */
.legend{display:flex;gap:10px;padding:10px 20px 0;flex-wrap:wrap}
.legend-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0}
.legend-item{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--text3)}

/* CALENDAR GRID */
.day-names{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;padding:10px 20px 4px}
.day-names span{text-align:center;font-size:9px;color:var(--text4);font-weight:700}
.cal-grid{padding:0 20px}
.week-row{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-bottom:3px}
.day-cell{aspect-ratio:1;border-radius:7px;border:1.5px solid var(--border);background:var(--bg3);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;padding:2px;transition:all .15s;position:relative}
.day-cell:hover{border-color:var(--border2);background:var(--bg4)}
.day-cell.done{border-color:var(--pc)!important;background:rgba(255,255,255,0.08)}
.day-cell.rest-day{background:#0a0a0a}
.day-cell.has-note::after{content:'';position:absolute;top:3px;right:3px;width:4px;height:4px;border-radius:50%;background:var(--orange)}
.day-cell .dn{font-size:8px;font-weight:700;color:var(--text4);line-height:1}
.day-cell.done .dn{color:var(--pc)}
.day-cell .di{font-size:11px}

/* WEEK BARS */
.week-bars{padding:18px 20px 0}
.section-label{font-size:9px;color:var(--text4);text-transform:uppercase;letter-spacing:.15em;margin-bottom:10px}
.wb-row{display:flex;align-items:center;gap:8px;margin-bottom:5px}
.wb-name{font-size:10px;color:var(--text4);width:52px;flex-shrink:0}
.wb-track{flex:1;height:4px;background:var(--bg4);border-radius:99px;overflow:hidden}
.wb-fill{height:100%;border-radius:99px;transition:width .3s}
.wb-count{font-size:10px;color:var(--text4);width:28px;text-align:right;flex-shrink:0}
.wb-phase{font-size:9px;width:46px;text-align:right;flex-shrink:0}

/* RULES BOX */
.rules-box{margin:18px 20px 0;background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:14px 16px}
.rules-box .rt{font-size:11px;color:var(--orange);font-weight:700;margin-bottom:10px}
.rules-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.rule-item{display:flex;gap:7px;align-items:flex-start}
.rule-i{font-size:14px;flex-shrink:0}
.rule-t{font-size:11px;color:var(--text3);line-height:1.4}

/* DAY DETAIL */
.dd-back{background:none;border:none;color:var(--text3);cursor:pointer;padding:14px 20px 6px;font-size:12px;display:flex;align-items:center;gap:5px}
.dd-back:hover{color:var(--text2)}
.dd-hdr{padding:0 20px 14px}
.dd-phase-lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;margin-bottom:4px}
.dd-row{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.dd-ico{font-size:24px}
.dd-ttl{font-size:20px;font-weight:900;line-height:1.1}
.dd-sub{font-size:11px;color:var(--text4);margin-top:2px}
.dd-goal{font-size:13px;color:var(--text2);background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:10px 12px;line-height:1.5;margin-bottom:12px}
.done-btn{width:100%;padding:13px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;border:2px solid var(--border2);background:var(--bg4);color:var(--text3);margin-bottom:8px}
.done-btn.done{background:var(--green);border-color:var(--green);color:#fff}
.edit-btn{width:100%;padding:10px;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;border:2px solid var(--border2);background:none;color:var(--text3);transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px}
.edit-btn:hover{border-color:var(--orange);color:var(--orange)}

/* BLOCKS */
.dd-block{margin:0 20px 14px}
.dd-block-ttl{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.15em;margin-bottom:7px}
.dd-block-body{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px 14px}
.ex-row{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;padding-bottom:10px;margin-bottom:10px;border-bottom:1px solid var(--bg4)}
.ex-row:last-child{padding-bottom:0;margin-bottom:0;border-bottom:none}
.ex-left{flex:1;min-width:0}
.ex-name{font-size:13px;font-weight:600;color:var(--text);line-height:1.4}
.ex-note{font-size:11px;color:var(--text4);margin-top:2px;line-height:1.4}
.ex-right{display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0}
.ex-sets{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;white-space:nowrap}
.ex-weight{font-size:11px;color:var(--text3);padding:3px 9px;border-radius:20px;white-space:nowrap;background:var(--bg4);border:1px solid var(--border2)}
.dd-tip{margin:0 20px 14px;background:var(--bg2);border-radius:0 8px 8px 0;padding:10px 14px}
.dd-tip-lbl{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-bottom:3px}
.dd-tip-txt{font-size:12px;color:var(--text2);line-height:1.6}
.warmup-txt{font-size:13px;color:var(--text2);line-height:1.6}
.dd-nav{display:flex;justify-content:space-between;padding:4px 20px 0}
.nav-btn{background:var(--bg3);border:1px solid var(--border);color:var(--text3);font-size:12px;padding:9px 14px;border-radius:8px;cursor:pointer}
.nav-btn:hover{background:var(--bg4);color:var(--text2)}
.nav-btn:disabled{opacity:.2;cursor:default}

/* NOTE BOX */
.note-box{margin:0 20px 14px}
.note-textarea{width:100%;background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-size:13px;color:var(--text);resize:none;min-height:80px;font-family:inherit;line-height:1.5;outline:none;transition:border-color .2s}
.note-textarea:focus{border-color:var(--orange)}
.note-textarea::placeholder{color:var(--text4)}
.note-save-btn{margin-top:6px;padding:8px 16px;background:var(--orange);border:none;border-radius:8px;color:#fff;font-size:12px;font-weight:700;cursor:pointer}

/* EDITOR */
.editor-wrap{padding:0 20px 20px}
.editor-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.editor-hdr h3{font-size:15px;font-weight:800}
.add-ex-btn{padding:8px 14px;background:var(--orange);border:none;border-radius:8px;color:#fff;font-size:12px;font-weight:700;cursor:pointer}
.ex-editor-row{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px;margin-bottom:8px;position:relative}
.ex-editor-row input,.ex-editor-row textarea{width:100%;background:var(--bg4);border:1px solid var(--border2);border-radius:7px;padding:8px 10px;font-size:12px;color:var(--text);font-family:inherit;outline:none;margin-bottom:6px;transition:border-color .2s}
.ex-editor-row input:focus,.ex-editor-row textarea:focus{border-color:var(--orange)}
.ex-editor-row textarea{resize:none;height:52px}
.ex-editor-row:last-child{margin-bottom:0}
.ex-row-top{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.del-ex-btn{position:absolute;top:8px;right:8px;background:none;border:none;color:var(--text4);cursor:pointer;font-size:16px;padding:2px 6px}
.del-ex-btn:hover{color:var(--red)}
.editor-actions{display:flex;gap:8px;margin-top:12px}
.save-btn{flex:1;padding:12px;background:var(--green);border:none;border-radius:10px;color:#fff;font-size:14px;font-weight:700;cursor:pointer}
.cancel-btn{padding:12px 20px;background:var(--bg4);border:1px solid var(--border2);border-radius:10px;color:var(--text3);font-size:14px;font-weight:700;cursor:pointer}
.block-editor{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:12px}
.block-editor-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.block-name-inp{background:var(--bg4);border:1px solid var(--border2);border-radius:7px;padding:6px 10px;font-size:13px;font-weight:700;color:var(--text);font-family:inherit;outline:none;flex:1;margin-right:8px}
.block-name-inp:focus{border-color:var(--orange)}
.del-block-btn{background:none;border:none;color:var(--text4);cursor:pointer;font-size:14px;padding:4px 8px}
.del-block-btn:hover{color:var(--red)}
.add-block-btn{width:100%;padding:10px;background:none;border:2px dashed var(--border2);border-radius:10px;color:var(--text4);font-size:13px;font-weight:700;cursor:pointer;margin-bottom:12px;transition:all .2s}
.add-block-btn:hover{border-color:var(--orange);color:var(--orange)}
.add-ex-in-block-btn{width:100%;padding:8px;background:none;border:1px dashed var(--border2);border-radius:8px;color:var(--text4);font-size:12px;cursor:pointer;margin-top:6px;transition:all .2s}
.add-ex-in-block-btn:hover{border-color:var(--blue);color:var(--blue)}
.meta-editor{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px;margin-bottom:12px}
.meta-editor label{font-size:10px;color:var(--text4);font-weight:700;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:4px;margin-top:8px}
.meta-editor label:first-child{margin-top:0}
.meta-editor input,.meta-editor textarea{width:100%;background:var(--bg4);border:1px solid var(--border2);border-radius:7px;padding:8px 10px;font-size:12px;color:var(--text);font-family:inherit;outline:none;transition:border-color .2s}
.meta-editor input:focus,.meta-editor textarea:focus{border-color:var(--orange)}
.meta-editor textarea{resize:none;height:64px}

/* TRACKER */
.tracker-section{padding:16px 20px 0}
.tracker-section h2{font-size:16px;font-weight:800;margin-bottom:4px}
.tracker-section p{font-size:12px;color:var(--text3);line-height:1.5;margin-bottom:14px}
.input-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
.input-row.three{grid-template-columns:1fr 1fr 1fr}
.input-group{display:flex;flex-direction:column;gap:4px}
.input-group label{font-size:10px;color:var(--text4);font-weight:700;text-transform:uppercase;letter-spacing:.08em}
.input-group input{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:10px 12px;font-size:14px;color:var(--text);font-family:inherit;outline:none;transition:border-color .2s}
.input-group input:focus{border-color:var(--orange)}
.add-record-btn{width:100%;padding:12px;background:var(--orange);border:none;border-radius:10px;color:#fff;font-size:14px;font-weight:700;cursor:pointer;margin-top:4px}
.card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:14px 16px;margin-bottom:12px}
.card-title{font-size:10px;color:var(--text4);text-transform:uppercase;letter-spacing:.12em;margin-bottom:10px;font-weight:700}
.stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px}
.stat-box{background:var(--bg3);border-radius:8px;padding:10px;text-align:center}
.stat-val{font-size:18px;font-weight:900;line-height:1}
.stat-lbl{font-size:10px;color:var(--text4);margin-top:3px}
.stat-delta{font-size:11px;margin-top:2px}

/* CHART */
.chart-wrap{position:relative;height:140px;margin:8px 0}
canvas{width:100%!important}
.chart-legend{display:flex;gap:12px;justify-content:center;margin-top:6px}
.chart-legend-item{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--text3)}
.chart-legend-dot{width:8px;height:8px;border-radius:50%}

/* RECORDS TABLE */
.records-table{width:100%;border-collapse:collapse}
.records-table th{font-size:9px;color:var(--text4);text-transform:uppercase;letter-spacing:.08em;padding:6px 8px;text-align:left;border-bottom:1px solid var(--border)}
.records-table td{font-size:12px;color:var(--text2);padding:8px;border-bottom:1px solid var(--border)}
.records-table td:first-child{color:var(--text)}
.records-table tr:last-child td{border-bottom:none}
.del-record-btn{background:none;border:none;color:var(--text4);cursor:pointer;font-size:13px;padding:2px 6px}
.del-record-btn:hover{color:var(--red)}

/* CALORIE CALC */
.calc-section{padding:16px 20px 0}
.calc-result-box{background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:16px;margin-top:12px}
.calc-main{font-size:28px;font-weight:900;color:var(--orange);line-height:1}
.calc-sub{font-size:12px;color:var(--text3);margin-top:4px;line-height:1.5}
.calc-breakdown{margin-top:12px;display:flex;flex-direction:column;gap:6px}
.calc-row-item{display:flex;justify-content:space-between;font-size:12px;color:var(--text3);padding:6px 0;border-bottom:1px solid var(--border)}
.calc-row-item:last-child{border-bottom:none}
.calc-row-item span:last-child{font-weight:700;color:var(--text)}
.radio-group{display:flex;gap:6px;flex-wrap:wrap;margin-top:4px}
.radio-btn{padding:7px 12px;border-radius:8px;border:1px solid var(--border2);background:var(--bg3);color:var(--text3);font-size:12px;cursor:pointer;transition:all .15s;font-weight:600}
.radio-btn.selected{border-color:var(--orange);background:rgba(217,119,6,0.15);color:var(--orange)}
.macro-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}
.macro-box{background:var(--bg4);border-radius:8px;padding:10px;text-align:center}
.macro-val{font-size:16px;font-weight:800}
.macro-lbl{font-size:10px;color:var(--text4);margin-top:2px}

/* TABS */
.tabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin:12px 20px 0}
.tab{flex:1;padding:10px 6px;background:none;border:none;border-bottom:2px solid transparent;color:var(--text4);font-size:11px;font-weight:700;cursor:pointer;text-transform:uppercase;letter-spacing:.06em;transition:all .15s;margin-bottom:-1px}
.tab.active{border-bottom-color:var(--orange);color:var(--orange)}

/* EMPTY STATE */
.empty-state{text-align:center;padding:30px 20px;color:var(--text4);font-size:13px}
.empty-state .ei{font-size:32px;margin-bottom:8px}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;display:flex;align-items:flex-end;justify-content:center}
.modal-overlay.hidden{display:none}
.modal{background:var(--bg2);border-radius:20px 20px 0 0;width:100%;max-width:720px;max-height:90vh;overflow-y:auto;padding:20px}
.modal-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.modal-hdr h3{font-size:16px;font-weight:800}
.modal-close{background:none;border:none;color:var(--text3);font-size:22px;cursor:pointer;padding:4px 8px}

/* TOAST */
.toast{position:fixed;top:20px;left:50%;transform:translateX(-50%);background:var(--green);color:#fff;padding:10px 20px;border-radius:99px;font-size:13px;font-weight:700;z-index:300;opacity:0;transition:opacity .3s;pointer-events:none}
.toast.show{opacity:1}

/* WEIGHT TRACKER ROW */
.wt-row-wrap{margin-top:8px;background:var(--bg4);border-radius:8px;padding:8px 10px;display:flex;flex-direction:column;gap:6px}
.wt-row-top{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.wt-inp-wrap{display:flex;align-items:center;gap:4px}
.wt-inp-wrap label{font-size:10px;color:var(--text4);white-space:nowrap}
.wt-inp{width:64px;background:var(--bg2);border:1px solid var(--border2);border-radius:6px;padding:5px 8px;font-size:13px;font-weight:700;color:var(--text);text-align:center;outline:none;transition:border-color .2s}
.wt-inp:focus{border-color:var(--orange)}
.wt-inp.reps-inp{width:48px}
.wt-all-done{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text4);cursor:pointer;user-select:none}
.wt-all-done input{accent-color:var(--green);width:14px;height:14px;cursor:pointer}
.wt-next-box{font-size:11px;line-height:1.4;padding:5px 8px;border-radius:6px}
.wt-next-box.up{background:rgba(22,163,74,0.12);color:#4ade80}
.wt-next-box.hold{background:rgba(217,119,6,0.12);color:var(--orange)}
.wt-next-box.firsttime{background:rgba(74,144,217,0.12);color:#7ec8ff}
.wt-save-btn{padding:5px 12px;background:var(--orange);border:none;border-radius:6px;color:#fff;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap}

/* UTILS */
.mt8{margin-top:8px}
.mt12{margin-top:12px}
.mt16{margin-top:16px}
.divider{height:1px;background:var(--border);margin:16px 0}
/* PROGRAMS */
.prog-card{margin:0 16px 14px;border-radius:12px;border:1px solid #1e1e1e;overflow:hidden}
.prog-hdr{padding:14px 16px;cursor:pointer;display:flex;gap:12px;align-items:flex-start}
.prog-hdr:active{background:#1a1a1a}
.prog-emoji{font-size:32px;flex-shrink:0}
.prog-info{flex:1}
.prog-name{font-size:16px;font-weight:900;color:#f0f0f0;margin-bottom:2px}
.prog-meta{font-size:11px;color:#555;margin-bottom:6px}
.prog-desc{font-size:12px;color:#888;line-height:1.5;margin-bottom:6px}
.prog-tags{display:flex;gap:5px;flex-wrap:wrap}
.prog-tag{font-size:10px;padding:2px 8px;border-radius:10px;background:#1a1a1a;color:#666;font-weight:600}
.prog-arr{font-size:14px;color:#444;transition:transform .2s;flex-shrink:0;padding-top:2px}
.prog-card.open .prog-arr{transform:rotate(180deg)}
.prog-phase{border-top:1px solid #1e1e1e;padding:10px 16px}
.prog-phase-title{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;margin-bottom:8px}
.prog-wlist{display:flex;flex-direction:column;gap:5px}
.prog-w{display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:#141414;border-radius:8px;border:1px solid #1e1e1e}
.prog-w-left{flex:1}
.prog-w-name{font-size:13px;font-weight:600;color:#f0f0f0}
.prog-w-meta{font-size:10px;color:#555;margin-top:1px}
.prog-w-btn{padding:5px 12px;background:#D97706;border:none;border-radius:7px;color:#fff;font-size:11px;font-weight:700;cursor:pointer;flex-shrink:0}
.prog-w-nolink{font-size:10px;color:#333;font-style:italic}
</style>
</head>
<body>

<!-- SCREENS -->
<div class="screen active" id="screen-cal">
  <div class="sticky-header">
    <h1>BODY<span>90</span> · <span>97 → 85 кг</span></h1>
    <div class="prog-row"><span>Выполнено дней</span><span id="prog-text">0 / 90 · 0%</span></div>
    <div class="prog-bar"><div class="prog-fill" id="prog-fill" style="width:0%"></div></div>
  </div>
  <div class="legend">
    <div class="legend-item"><div class="legend-dot" style="background:var(--phase1)"></div>Нед.1–4 ВХОД</div>
