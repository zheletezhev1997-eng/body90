    html+=renderBlockEditor(bl,bi);
  });
  html+=`</div>`;
  html+=`<button class="add-block-btn" onclick="addBlock()">+ Добавить блок упражнений</button>`;
  html+=`<div class="editor-actions">
    <button class="cancel-btn" onclick="closeEditor()">Отмена</button>
    <button class="save-btn" onclick="saveEditor()">💾 Сохранить</button>
  </div>`;

  container.innerHTML=html;
}

function renderBlockEditor(bl,bi){
  let exs='';
  (bl.exs||[]).forEach((ex,ei)=>{
    exs+=`<div class="ex-editor-row" id="ex-${bi}-${ei}">
      <button class="del-ex-btn" onclick="delEx(${bi},${ei})">✕</button>
      <div class="ex-row-top">
        <input placeholder="Название упражнения" class="ex-n" value="${esc(ex.n||'')}">
        <input placeholder="Подходы × повт." class="ex-s" value="${esc(ex.s||'')}">
      </div>
      <div class="ex-row-top">
        <input placeholder="Вес (кг)" class="ex-w" value="${esc(ex.w||'')}">
        <input placeholder="Заметка" class="ex-note" value="${esc(ex.note||'')}">
      </div>
    </div>`;
  });
  return `<div class="block-editor" id="block-${bi}">
    <div class="block-editor-hdr">
      <input class="block-name-inp" placeholder="Название блока" value="${esc(bl.t||'')}" id="block-name-${bi}">
      <button class="del-block-btn" onclick="delBlock(${bi})">✕ блок</button>
    </div>
    <div id="block-exs-${bi}">${exs}</div>
    <button class="add-ex-in-block-btn" onclick="addExInBlock(${bi})">+ упражнение</button>
  </div>`;
}

function addBlock(){
  const be=document.getElementById('blocks-editor');
  const bi=be.querySelectorAll('.block-editor').length;
  const div=document.createElement('div');
  div.innerHTML=renderBlockEditor({t:'Новый блок',exs:[]},bi);
  be.appendChild(div.firstChild);
}

function delBlock(bi){
  const el=document.getElementById('block-'+bi);
  if(el) el.remove();
}

function addExInBlock(bi){
