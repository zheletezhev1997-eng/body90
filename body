function onWeightInput(wkey){
  // live-update next suggestion without saving
  const kgEl=document.getElementById('wkg-'+wkey);
  const allEl=document.getElementById('wall-'+wkey);
  const nextEl=document.getElementById('wnext-'+wkey);
  if(!nextEl) return;
  const kg=kgEl?parseFloat(kgEl.value)||0:0;
  const allDone=allEl?allEl.checked:false;
  let html='';
  if(!kg){
    html=`<div class="wt-next-box firsttime">💡 Введи рабочий вес этой тренировки</div>`;
  } else if(allDone){
    const step=kg>=40?2.5:kg>=20?2:1.25;
    html=`<div class="wt-next-box up">▲ Следующий раз: <b>${(kg+step).toFixed(step===1.25?2:1)} кг</b> (+${step} кг) — все подходы выполнены ✓</div>`;
  } else {
    html=`<div class="wt-next-box hold">→ Следующий раз: <b>${kg} кг</b> — держи вес, добери повторения</div>`;
  }
  nextEl.innerHTML=html;
}

function saveWeight(wkey){
  const kgEl=document.getElementById('wkg-'+wkey);
  const repsEl=document.getElementById('wreps-'+wkey);
  const allEl=document.getElementById('wall-'+wkey);
  const kg=kgEl?parseFloat(kgEl.value)||null:null;
  const reps=repsEl?parseInt(repsEl.value)||null:null;
  const allDone=allEl?allEl.checked:false;
  if(!state.myWeights) state.myWeights={};
  state.myWeights[wkey]={kg,reps,allDone,date:new Date().toISOString().split('T')[0]};
  saveState();
  onWeightInput(wkey);
  toast('Вес сохранён ✓');
}

// History of weights for a given exercise name across all days
function getWeightHistory(exName){
  const hist=[];
  Object.entries(state.myWeights||{}).forEach(([key,val])=>{
    if(!val.kg) return;
    const [dayIdx,bi,ei]=key.split(':').map(Number);
    const d=getDayData(dayIdx);
    const ex=d.blocks&&d.blocks[bi]&&d.blocks[bi].exs?d.blocks[bi].exs[ei]:null;
    if(ex && ex.n===exName){
      hist.push({day:dayIdx+1,kg:val.kg,reps:val.reps,allDone:val.allDone,date:val.date});
    }
  });
  hist.sort((a,b)=>a.day-b.day);
  return hist;
}

