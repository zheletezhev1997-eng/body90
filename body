function calcCalories(){
  const weight=parseFloat(document.getElementById('c-weight').value)||97;
  const height=parseFloat(document.getElementById('c-height').value)||175;
  const age=parseFloat(document.getElementById('c-age').value)||30;

  let bmr;
  if(calcGender==='m') bmr=10*weight+6.25*height-5*age+5;
  else bmr=10*weight+6.25*height-5*age-161;

  const tdee=Math.round(bmr*calcActivity);
  const target=tdee-calcDeficit;
  const protein=Math.round(weight*1.9);
  const fat=Math.round(weight*1);
  const carbCal=target-protein*4-fat*9;
  const carbs=Math.max(0,Math.round(carbCal/4));
  const lossPerWeek=((calcDeficit*7)/7700).toFixed(2);

  const box=document.getElementById('calc-result');
  box.innerHTML=`
    <div style="margin-bottom:12px">
      <div style="font-size:10px;color:var(--text4);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px">Твой план питания</div>
      <div class="calc-main">${target} <span style="font-size:16px;color:var(--text3)">ккал/день</span></div>
      <div class="calc-sub">Дефицит ${calcDeficit} ккал · похудение ~${lossPerWeek} кг/нед</div>
    </div>
    <div class="calc-breakdown">
      <div class="calc-row-item"><span>BMR (базовый обмен)</span><span>${Math.round(bmr)} ккал</span></div>
      <div class="calc-row-item"><span>TDEE (с активностью)</span><span>${tdee} ккал</span></div>
      <div class="calc-row-item"><span>Дефицит</span><span style="color:var(--red)">− ${calcDeficit} ккал</span></div>
      <div class="calc-row-item"><span>Цель в день</span><span style="color:var(--orange)">${target} ккал</span></div>
    </div>
    <div style="font-size:10px;color:var(--text4);text-transform:uppercase;letter-spacing:.1em;margin:12px 0 6px">Макросы на день</div>
    <div class="macro-grid">
      <div class="macro-box"><div class="macro-val" style="color:var(--red)">${protein}г</div><div class="macro-lbl">Белок</div><div style="font-size:10px;color:var(--text4)">${protein*4} ккал</div></div>
      <div class="macro-box"><div class="macro-val" style="color:var(--orange)">${fat}г</div><div class="macro-lbl">Жиры</div><div style="font-size:10px;color:var(--text4)">${fat*9} ккал</div></div>
      <div class="macro-box"><div class="macro-val" style="color:var(--blue)">${carbs}г</div><div class="macro-lbl">Углеводы</div><div style="font-size:10px;color:var(--text4)">${carbs*4} ккал</div></div>
    </div>
    <div style="margin-top:10px;font-size:11px;color:var(--text4);line-height:1.5">
      При 97 кг белок ~${protein}г/день критичен для сохранения мышц на дефиците.
    </div>`;
}

