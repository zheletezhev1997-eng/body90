              <td style="cursor:pointer;color:var(--blue)" onclick="openDay(${r.day-1})">${r.day}</td>
              <td>${r.kg} кг</td>
              <td style="color:${r.allDone?'var(--green)':'var(--orange)'}">${r.allDone?'✓ все подходы':'~ добрать'}</td>
            </tr>`).join('')}
          </tbody>
        </table>
      </div>
    </div>`;
  });
  html+='</div>';
  container.innerHTML=html;
}

