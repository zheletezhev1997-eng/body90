var openProgs={};

function renderProgs(){
  var c=document.getElementById('prog-list');
  if(!c) return;
  var html='';
  PROGS.forEach(function(p){
    var isOpen=openProgs[p.id];
    var total=p.phases.reduce(function(s,ph){return s+ph.ws.length;},0);
    var linked=p.phases.reduce(function(s,ph){return s+ph.ws.filter(function(w){return w.url;}).length;},0);
    html+='<div class="prog-card'+(isOpen?' open':'')+'">';
    html+='<div class="prog-hdr" onclick="toggleProg(\''+p.id+'\')">'+
      '<div class="prog-emoji">'+p.emoji+'</div>'+
      '<div class="prog-info">'+
        '<div class="prog-name">'+p.name+'</div>'+
        '<div class="prog-meta">'+p.author+'</div>'+
        '<div class="prog-tags">'+
          '<span class="prog-tag" style="color:'+p.color+'">'+p.level+'</span>'+
          '<span class="prog-tag">'+p.time+'</span>'+
          '<span class="prog-tag">'+p.duration+'</span>'+
        '</div>'+
        '<div class="prog-desc" style="margin-top:6px">'+p.desc+'</div>'+
        '<div style="font-size:10px;color:#444;margin-top:4px">'+total+' тренировок · '+linked+' со ссылками</div>'+
      '</div>'+
      '<div class="prog-arr">▾</div>'+
    '</div>';
    if(isOpen){
      p.phases.forEach(function(ph){
        html+='<div class="prog-phase">'+
          '<div class="prog-phase-title" style="color:'+ph.color+'">'+ph.name+'</div>'+
          '<div class="prog-wlist">';
        ph.ws.forEach(function(w,wi){
          var phIdx=p.phases.indexOf(ph);
          html+='<div class="prog-w">'+
            '<div class="prog-w-left">'+
              '<div class="prog-w-name">'+w.n+'</div>'+
              '<div class="prog-w-meta">'+w.m+'</div>'+
            '</div>';
          if(w.url){
            html+='<button class="prog-w-btn" onclick="openVid(\''+p.id+'\','+phIdx+','+wi+')">▶ Открыть</button>';
          } else {
            html+='<span class="prog-w-nolink">нет ссылки</span>';
          }
          html+='</div>';
        });
        html+='</div></div>';
      });
    }
    html+='</div>';
  });
  c.innerHTML=html;
}

function toggleProg(id){
  openProgs[id]=!openProgs[id];
  renderProgs();
  setTimeout(function(){
    var el=document.querySelector('.prog-card.open');
    if(el) el.scrollIntoView({behavior:'smooth',block:'start'});
  },50);
}

function openVid(progId,phIdx,wIdx){
  var p=PROGS.find(function(x){return x.id===progId;});
  if(!p) return;
  var w=p.phases[phIdx].ws[wIdx];
  if(w && w.url) window.open(w.url,'_blank');
  else toast('Ссылка не добавлена');
}

