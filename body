// ─── SIMPLE CANVAS CHART ───────────────────
function drawBodyChart(){
  const canvas=document.getElementById('bodyChart');
  if(!canvas) return;
  const recs=state.records;
  const wRecs=recs.filter(r=>r.weight!=null);
  const waRecs=recs.filter(r=>r.waist!=null);
  if(!wRecs.length&&!waRecs.length){
    const ctx=canvas.getContext('2d');
    canvas.width=canvas.offsetWidth*2;canvas.height=280;
    ctx.fillStyle='#1a1a1a';ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle='#444';ctx.font='24px system-ui';ctx.textAlign='center';
    ctx.fillText('Добавь замеры для графика',canvas.width/2,canvas.height/2);
    return;
  }
  const W=canvas.offsetWidth*2;const H=280;
  canvas.width=W;canvas.height=H;
  const ctx=canvas.getContext('2d');
  ctx.scale(1,1);
  const PAD={t:20,r:20,b:30,l:50};
  const cw=W-PAD.l-PAD.r;const ch=H-PAD.t-PAD.b;
  ctx.fillStyle='#141414';ctx.fillRect(0,0,W,H);

  // grid
  ctx.strokeStyle='#1e1e1e';ctx.lineWidth=1;
  for(let i=0;i<=4;i++){
    const y=PAD.t+ch*(i/4);
    ctx.beginPath();ctx.moveTo(PAD.l,y);ctx.lineTo(PAD.l+cw,y);ctx.stroke();
  }

  function drawLine(data,keyDate,keyVal,color,label,minV,maxV){
    if(!data.length) return;
    const range=maxV-minV||1;
    ctx.beginPath();ctx.strokeStyle=color;ctx.lineWidth=3;ctx.lineJoin='round';
    const allDates=recs.map(r=>r.date);
    const minDate=new Date(allDates[0]).getTime();
    const maxDate=new Date(allDates[allDates.length-1]).getTime();
    const dateRange=maxDate-minDate||1;
    data.forEach((r,i)=>{
      const x=PAD.l+((new Date(r.date).getTime()-minDate)/dateRange)*cw;
      const y=PAD.t+ch*(1-(r[keyVal]-minV)/range);
      if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    });
    ctx.stroke();
    // dots
    data.forEach(r=>{
      const x=PAD.l+((new Date(r.date).getTime()-minDate)/dateRange)*cw;
      const y=PAD.t+ch*(1-(r[keyVal]-minV)/range);
      ctx.beginPath();ctx.arc(x,y,5,0,Math.PI*2);ctx.fillStyle=color;ctx.fill();
    });
    // y labels
    ctx.fillStyle=color;ctx.font=`${22}px system-ui`;ctx.textAlign='right';
    for(let i=0;i<=4;i++){
      const v=minV+(range*i/4);
      const y=PAD.t+ch*(1-i/4);
      ctx.fillText(v.toFixed(1),PAD.l-6,y+5);
    }
  }

  const wVals=wRecs.map(r=>r.weight);
  const waVals=waRecs.map(r=>r.waist);
  const allW=wVals.length?[Math.min(...wVals)-2,Math.max(...wVals)+2]:[80,100];
  const allWa=waVals.length?[Math.min(...waVals)-2,Math.max(...waVals)+2]:[80,110];

  // target line for weight
  if(wRecs.length>0){
    const allDates=recs.map(r=>r.date);
    const minDate=new Date(allDates[0]).getTime();
    const maxDate=new Date(allDates[allDates.length-1]).getTime();
    const dateRange=maxDate-minDate||1;
    const ty=PAD.t+ch*(1-(85-allW[0])/(allW[1]-allW[0]));
    ctx.setLineDash([8,4]);ctx.strokeStyle='#16A34A';ctx.lineWidth=1.5;
    ctx.beginPath();ctx.moveTo(PAD.l,ty);ctx.lineTo(PAD.l+cw,ty);ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle='#16A34A';ctx.font='20px system-ui';ctx.textAlign='left';
    ctx.fillText('цель 85',PAD.l+4,ty-6);
  }

  drawLine(wRecs,'date','weight','#4A90D9','Вес',allW[0],allW[1]);
  if(waRecs.length) drawLine(waRecs,'date','waist','#D97706','Талия',allWa[0],allWa[1]);

  // x labels
  ctx.fillStyle='#444';ctx.font='18px system-ui';ctx.textAlign='center';
  const allDates=recs.map(r=>r.date);
  const minDate=new Date(allDates[0]).getTime();
  const maxDate=new Date(allDates[allDates.length-1]).getTime();
  const dateRange=maxDate-minDate||1;
  [allDates[0],allDates[allDates.length-1]].forEach(d=>{
    const x=PAD.l+((new Date(d).getTime()-minDate)/dateRange)*cw;
    ctx.fillText(formatDate(d),x,H-6);
  });
}

