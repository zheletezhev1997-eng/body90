function showScreen(name){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('screen-'+name).classList.add('active');
  document.querySelectorAll('.bnav-btn').forEach(b=>b.classList.remove('active'));
  if(name==='cal'||name==='day') document.getElementById('bnav-cal').classList.add('active');
  if(name==='tracker') document.getElementById('bnav-tracker').classList.add('active');
  if(name==='prog') document.getElementById('bnav-prog').classList.add('active');
  if(name==='tracker'){renderTracker();}
  if(name==='cal'){renderCalendar();}
  if(name==='prog'){renderProgs();}
  window.scrollTo(0,0);
}

function toast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2000);
}

