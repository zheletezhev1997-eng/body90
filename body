let state={
  completed:{},   // {dayIdx: true}
  notes:{},       // {dayIdx: "text"}
  customDays:{},  // {dayIdx: dayData}  — user-edited days
  records:[],     // [{date,weight,waist}]
  myWeights:{},   // {"dayIdx:blockIdx:exIdx": {kg, reps, allDone}}
};

function loadState(){
  try{const s=localStorage.getItem("t90v5");if(s)state={...state,...JSON.parse(s)};}catch{}
}
function saveState(){
  try{localStorage.setItem("t90v5",JSON.stringify(state));}catch{}
}
loadState();

function getDayData(idx){
  if(state.customDays[idx]) return {...state.customDays[idx],_custom:true};
  const week=Math.floor(idx/7)+1;
  const dow=idx%7;
  const ph=getPhase(week);
  const tpl=JSON.parse(JSON.stringify(DEFAULT_TEMPLATES[ph.id][dow]));
  return {...tpl,phase:ph,week,dow,dayNum:idx+1};
}

