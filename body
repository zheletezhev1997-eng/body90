      </div>
      <span style="font-size:11px;color:${dc===all?'var(--green)':dc>0?'var(--orange)':'var(--text4)'};font-weight:700;width:32px;text-align:right">${dc}/${all}</span>
      <span style="font-size:9px;color:${ph.color};width:48px;text-align:right">${ph.label}</span>
    </div>`;
  }
